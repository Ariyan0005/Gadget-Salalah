# ==============================================================================
# Gadget Salalah — High Performance Nginx Configuration for VPS (8GB RAM / 500GB SSD)
# Optimized for 10,000+ concurrent users with static asset caching & load balancing
# Place in: /etc/nginx/sites-available/gadgetsalalah.com
# ==============================================================================

upstream gadgetsalalah_api {
    # Distributes connections across the PM2 cluster backend
    server 127.0.0.1:3000;
    keepalive 64; # Maintain persistent connection pool to Node.js backend
}

server {
    listen 80;
    listen [::]:80;
    server_name gadgetsalalah.com www.gadgetsalalah.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gadgetsalalah.com www.gadgetsalalah.com;

    # SSL Certificates (managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/gadgetsalalah.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gadgetsalalah.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Root directory for static SPA build
    root /var/www/gadgetsalalah/artifacts/shop/dist/public;
    index index.html;

    # GZIP Compression (reduces page transfer size by 70% for instant mobile load)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        text/xml
        application/xml
        application/xml+rss
        image/svg+xml;

    # Browser Caching for static assets (images, fonts, scripts)
    location ~* \.(webp|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(css|js)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # API Proxy to PM2 Node.js Cluster
    location /api/ {
        proxy_pass http://gadgetsalalah_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts & Buffering
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 32k;
    }

    # SPA Client-Side Routing Fallback
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
